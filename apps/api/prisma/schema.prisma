// apps/api/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  
  orders    Order[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Int      // Harga per unit / per kg (Rupiah)
  weightGram  Int      @default(1000) // Berat gram (misal 500g, 1000g)
  unit        String   @default("kg") // "kg" atau "pack"
  stock       Int      @default(0)
  imageUrl    String?
  
  isFresh     Boolean  @default(true)  // Badge Ikan Segar
  isFrozen    Boolean  @default(false) // Badge Ikan Beku / IQF
  isProcessed Boolean  @default(false) // Badge Ikan Olahan / Bumbu
  
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  totalPrice      Int
  status          OrderStatus @default(PENDING)
  shippingAddress String?
  shippingMethod  String?     @default("Instant Cold-Chain")
  notes           String?
  
  snapToken       String?
  snapRedirectUrl String?
  
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  price     Int     // Harga per barang saat checkout
  
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING     // Menunggu Pembayaran
  PAID        // Sudah Dibayar
  PROCESSING  // Pesanan Diproses / Dikemas
  SHIPPED     // Dalam Pengiriman Kurir
  DELIVERED   // Selesai & Diterima
  CANCELLED   // Dibatalkan
}