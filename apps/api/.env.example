# ==============================================================================
# PANENQU API - ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Petunjuk: Salin file ini menjadi ".env" di folder apps/api dan sesuaikan nilainya.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SUPABASE / POSTGRESQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: URL koneksi PGBouncer / Transaction Mode (Port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"

# DIRECT_URL: URL koneksi Langsung / Direct Connection untuk Prisma Migration (Port 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE STORAGE (MEDIA & FOTO PRODUK)
# ------------------------------------------------------------------------------
# Supabase URL & Anon Key untuk upload gambar produk ke Supabase Bucket
SUPABASE_URL="https://[YOUR_SUPABASE_REF].supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_BUCKET="products"

# ------------------------------------------------------------------------------
# 3. MIDTRANS PAYMENT GATEWAY CONFIG
# ------------------------------------------------------------------------------
# Server Key & Client Key dari Dashboard Midtrans (Sandbox / Production)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
# Set "false" untuk mode pengujian (Sandbox), ubah ke "true" untuk Live Production
MIDTRANS_IS_PRODUCTION="false"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Key rahasia untuk enkripsi token JWT login user
JWT_SECRET="super-secret-jwt-key-panenqu-2026"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 5. SERVER & CORS CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8000

# URL Frontend yang diizinkan mengakses API (dipisahkan koma untuk multiple URL)
# Saat handover, ganti dengan URL domain Frontend Vercel klien Anda
FRONTEND_URL="http://localhost:3000,http://localhost:3001,https://panenqu.vercel.app"
